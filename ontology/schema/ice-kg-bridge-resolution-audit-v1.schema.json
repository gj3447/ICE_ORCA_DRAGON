{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ice-orca-dragon.local/schema/ice-kg-bridge-resolution-audit-v1.schema.json",
  "title": "ICE external KG bridge resolution audit v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "audit_id",
    "checked_at_utc",
    "authority",
    "result_status",
    "does_not_alter_canonical_bridge_status",
    "scope",
    "outcomes",
    "rules",
    "default_outcome",
    "non_claim"
  ],
  "properties": {
    "$schema": {
      "const": "../../ontology/schema/ice-kg-bridge-resolution-audit-v1.schema.json"
    },
    "schema_version": { "const": "ice-kg-bridge-resolution-audit/v1" },
    "audit_id": {
      "type": "string",
      "pattern": "^audit:[a-z0-9-]+$"
    },
    "checked_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "authority": { "const": "READ_ONLY_AUDIT_SIDECAR" },
    "result_status": { "const": "ZERO_RESOLVED_MATCHES" },
    "does_not_alter_canonical_bridge_status": { "const": true },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_graphs",
        "expected_unresolved_count",
        "expected_keyset_sha256",
        "keyset_encoding"
      ],
      "properties": {
        "canonical_graphs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonblank" }
        },
        "expected_unresolved_count": { "type": "integer", "minimum": 0 },
        "expected_keyset_sha256": { "$ref": "#/$defs/sha256" },
        "keyset_encoding": { "$ref": "#/$defs/nonblank" }
      }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["NO_MATCH", "ID_COLLISION", "REGISTRY_UNAVAILABLE"],
      "properties": {
        "NO_MATCH": { "$ref": "#/$defs/nonblank" },
        "ID_COLLISION": { "$ref": "#/$defs/nonblank" },
        "REGISTRY_UNAVAILABLE": { "$ref": "#/$defs/nonblank" }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/rule" }
    },
    "default_outcome": { "const": "NO_MATCH" },
    "non_claim": { "$ref": "#/$defs/nonblank" }
  },
  "$defs": {
    "nonblank": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "blob_oid",
        "path",
        "url",
        "access_verification",
        "anchors",
        "boundary"
      ],
      "properties": {
        "repository": { "const": "https://github.com/gj3447/symposium" },
        "commit": { "$ref": "#/$defs/gitOid" },
        "blob_oid": { "$ref": "#/$defs/gitOid" },
        "path": { "$ref": "#/$defs/nonblank" },
        "url": { "type": "string", "format": "uri" },
        "access_verification": { "const": "GH_API_AND_GIT_LS_REMOTE" },
        "anchors": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^phase:p[0-9]+$" },
          "additionalProperties": {
            "type": "string",
            "pattern": "^L[0-9]+$"
          }
        },
        "boundary": { "$ref": "#/$defs/nonblank" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outcome", "graph", "system", "local_node_ids"],
      "properties": {
        "id": { "type": "string", "pattern": "^rule:[a-z0-9-]+$" },
        "outcome": {
          "enum": ["NO_MATCH", "ID_COLLISION", "REGISTRY_UNAVAILABLE"]
        },
        "graph": { "$ref": "#/$defs/nonblank" },
        "system": { "$ref": "#/$defs/nonblank" },
        "local_node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonblank" }
        },
        "registry_locator": { "$ref": "#/$defs/locator" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "outcome": { "const": "ID_COLLISION" } },
            "required": ["outcome"]
          },
          "then": { "required": ["registry_locator"] },
          "else": { "not": { "required": ["registry_locator"] } }
        }
      ]
    }
  }
}
