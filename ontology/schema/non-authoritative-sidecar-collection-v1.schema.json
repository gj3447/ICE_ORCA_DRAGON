{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ice-orca-dragon.local/schema/non-authoritative-sidecar-collection-v1.schema.json",
  "title": "ICE non-authoritative sidecar collection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "collection_id", "title", "description", "updated_at_utc", "authority", "canonical_graph_unchanged", "does_not_authorize_execution", "entries", "boundaries"],
  "properties": {
    "$schema": { "const": "../../ontology/schema/non-authoritative-sidecar-collection-v1.schema.json" },
    "schema_version": { "const": "non-authoritative-sidecar-collection/v1" },
    "collection_id": { "const": "sidecar-collection:ice-orca-dragon" },
    "title": { "$ref": "#/$defs/nonblank" },
    "description": { "$ref": "#/$defs/nonblank" },
    "updated_at_utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "authority": { "const": "NON_AUTHORITATIVE_SIDECAR_REGISTRY" },
    "canonical_graph_unchanged": { "const": true },
    "does_not_authorize_execution": { "const": true },
    "entries": { "type": "array", "minItems": 3, "maxItems": 16, "items": { "$ref": "#/$defs/entry" } },
    "boundaries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonblank" } }
  },
  "$defs": {
    "nonblank": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "path", "schema_path", "schema_version", "document_sha256", "state", "authority", "canonical_graph_unchanged", "does_not_authorize_execution", "non_claim", "boundary"],
      "properties": {
        "id": { "type": "string", "pattern": "^sidecar:[a-z0-9][a-z0-9-]{2,127}$" },
        "title": { "$ref": "#/$defs/nonblank" },
        "kind": { "enum": ["SCIENTIFIC_INTUITION_V1", "SCIENTIFIC_INTUITION_V2", "COMPARATOR_PROTOCOL_V1"] },
        "path": { "type": "string", "pattern": "^research/" },
        "schema_path": { "type": "string", "pattern": "^ontology/schema/" },
        "schema_version": { "$ref": "#/$defs/nonblank" },
        "document_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "state": { "enum": ["FROZEN_SNAPSHOT", "ACTIVE_HYPOTHESIS_GENERATION", "ACTIVE_METHOD_PROTOCOL"] },
        "authority": { "enum": ["NON_AUTHORITATIVE_HYPOTHESIS_GENERATION", "NON_AUTHORITATIVE_METHOD_PROTOCOL"] },
        "canonical_graph_unchanged": { "const": true },
        "does_not_authorize_execution": { "const": true },
        "non_claim": { "$ref": "#/$defs/nonblank" },
        "boundary": { "$ref": "#/$defs/nonblank" }
      }
    }
  }
}
