{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-schema-lifecycle-v1.schema.json",
  "title": "ICE research schema lifecycle registry",
  "description": "Machine-readable supported-version and migration lifecycle. Native collection and graph JSON remain the sole authored records.",
  "type": "object",
  "required": ["$schema", "schema", "version", "families"],
  "properties": {
    "$schema": { "const": "./research-schema-lifecycle-v1.schema.json" },
    "schema": { "const": "ice-research-schema-lifecycle/v1" },
    "version": { "const": 1 },
    "families": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["current", "supported", "migrations"],
        "properties": {
          "current": { "type": "string" },
          "supported": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "migrations": { "type": "array", "items": { "type": "object" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
