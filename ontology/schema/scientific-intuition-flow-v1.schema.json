{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scientific-intuition-flow-v1.schema.json",
  "title": "Non-authoritative scientific intuition signal sidecar",
  "description": "A bounded, source-linked hypothesis-generation layer. It cannot alter a canonical research graph, establish a scientific claim, or authorize execution.",
  "type": "object",
  "required": [
    "schema_version",
    "graph_id",
    "title",
    "description",
    "updated_at_utc",
    "authority",
    "canonical_graph_unchanged",
    "does_not_authorize_execution",
    "standards_alignment",
    "sources",
    "signals",
    "boundaries"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "scientific-intuition-flow/v1" },
    "graph_id": { "const": "intuition-flow:gate1" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "updated_at_utc": { "type": "string", "format": "date-time" },
    "authority": { "const": "NON_AUTHORITATIVE_HYPOTHESIS_GENERATION" },
    "canonical_graph_unchanged": { "const": true },
    "does_not_authorize_execution": { "const": true },
    "standards_alignment": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/standardAlignment" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/source" }
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/signal" }
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "standardAlignment": {
      "type": "object",
      "required": ["id", "standard", "uri", "status", "boundary"],
      "properties": {
        "id": { "type": "string", "pattern": "^standard:" },
        "standard": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "format": "uri" },
        "status": { "type": "string", "minLength": 1 },
        "boundary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "canonicalSource": {
      "type": "object",
      "required": ["graph", "node"],
      "properties": {
        "graph": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "node": { "type": "string", "pattern": "^source:" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["id", "kind", "citation", "uri", "version", "retrieved_at_utc", "pinpoint", "role", "boundary"],
      "properties": {
        "id": { "type": "string", "pattern": "^source-ref:" },
        "kind": { "enum": ["PRIMARY_PAPER", "OFFICIAL_GUIDANCE", "STANDARD"] },
        "citation": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "format": "uri" },
        "version": { "type": "string", "minLength": 1 },
        "retrieved_at_utc": { "type": "string", "format": "date-time" },
        "pinpoint": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "boundary": { "type": "string", "minLength": 1 },
        "canonical_source": { "$ref": "#/$defs/canonicalSource" }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["graph", "node"],
      "properties": {
        "graph": { "const": "cpt" },
        "node": { "type": "string", "pattern": "^open:" }
      },
      "additionalProperties": false
    },
    "signal": {
      "type": "object",
      "required": [
        "id",
        "status",
        "kind",
        "target",
        "lens",
        "why_relevant",
        "source_refs",
        "assumptions",
        "discriminating_observation",
        "stop_condition",
        "principal_failure_class",
        "non_claim",
        "does_not_authorize_execution"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^intuition:" },
        "status": { "enum": ["CANDIDATE", "REJECTED", "RETIRED"] },
        "kind": { "enum": ["MISSING_TYPED_OBJECT", "METHOD_ANALOGY", "SEPARATION_TEST", "DISCRIMINATOR"] },
        "target": { "$ref": "#/$defs/target" },
        "lens": { "type": "string", "minLength": 1, "pattern": "\\?$" },
        "why_relevant": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^source-ref:" }
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "discriminating_observation": { "type": "string", "minLength": 1 },
        "stop_condition": { "type": "string", "minLength": 1 },
        "principal_failure_class": { "enum": ["algebra", "sign/unit", "discretization", "truncation", "solver", "spectrum", "gauge", "inference"] },
        "non_claim": { "type": "string", "minLength": 1 },
        "does_not_authorize_execution": { "const": true }
      },
      "additionalProperties": false
    }
  }
}
