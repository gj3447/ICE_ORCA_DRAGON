{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-run-evidence-v1.schema.json",
  "title": "Research run evidence snapshot",
  "description": "A durable snapshot of one research executable run. Exact checks are required; an optional typed numerical ledger preserves bounded numerical controls. Numbered historical runs carry a phase label; independent unnumbered runs use null.",
  "type": "object",
  "required": [
    "schema_version",
    "result_id",
    "phase",
    "observed_at_utc",
    "command",
    "exit_code",
    "script",
    "exact_checks",
    "checks",
    "payload"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "research-run-evidence/v1"
    },
    "result_id": {
      "type": "string",
      "pattern": "^result:[A-Za-z0-9_.:-]+$"
    },
    "phase": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^P[0-9]+[A-Z]?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "exit_code": {
      "type": "integer"
    },
    "script": {
      "$ref": "#/$defs/artifactReference"
    },
    "exact_checks": {
      "type": "integer",
      "minimum": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "numerical_checks": {
      "type": "integer",
      "minimum": 0
    },
    "numerical": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "artifactReference": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "introduced_in_commit"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "introduced_in_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "status",
        "statement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)+$"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "INCONCLUSIVE"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
